#!/usr/bin/env bash
# CI stand-in for the one `repro` form the regenerate scripts use:
#
#   repro exec <repo-dir> -- <command> [args...]
#
# which runs <command> inside <repo-dir>'s development environment.  The
# self-hosted macOS runners have Nix but no reprobuild install, and the
# recorder's development environment is its flake dev shell, so this runs
#
#   nix develop <repo-dir> --command <command> [args...]
#
# in the current directory.  Any other `repro` invocation is refused rather
# than guessed at.  regen-device-recordings.yml puts this directory first on
# PATH; it is not meant for developer machines, which have the real `repro`.

set -euo pipefail

if [ "$#" -lt 3 ] || [ "$1" != "exec" ]; then
  echo "repro (CI shim): only 'repro exec <repo-dir> -- <command...>' is supported; got: repro $*" >&2
  exit 2
fi
dir="$2"
shift 2
if [ "${1:-}" = "--" ]; then
  shift
fi
if [ "$#" -eq 0 ]; then
  echo "repro (CI shim): no command after 'repro exec $dir --'" >&2
  exit 2
fi
exec nix develop "$dir" --command "$@"
